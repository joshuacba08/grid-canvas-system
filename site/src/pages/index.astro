---
import { ArrowUpRight, Check, Cookie, Copy, Gamepad2, Moon } from "@lucide/astro";
import { codeToHtml } from "shiki";

import "../styles/global.css";

const version = "0.3.0";
const repoUrl = "https://github.com/joshuacba08/grid-canvas-system";
const npmUrl = "https://www.npmjs.com/package/grid-canvas-system";
const heroCode = `const grid = new GridCanvasSystem("canvas", {
  cellSize: 20,
  backgroundColor: "#050607"
});

const pointer = GridCanvasSystem.runtime
  .createPointerTracker(grid.canvas);

const loop = GridCanvasSystem.runtime
  .createAnimationLoop({
    autoStart: true,
    update: tick,
    draw: render
  });`;

const capabilities = [
  {
    name: "Grid-first canvas",
    text: "Initialize an HTML canvas with predictable sizing, HiDPI rendering, visible grid lines and coordinate labels.",
    code: 'new GridCanvasSystem("canvas", { cellSize: 20 })',
  },
  {
    name: "Pixel sprites",
    text: "Draw matrix-based pixel art with strict palettes, transparent cells and absolute canvas coordinates.",
    code: "grid.drawPixelSprite(sprite, options)",
  },
  {
    name: "Arcade shapes",
    text: "Compose Pac-Man, ghosts, projectiles, spaceships, asteroids, sectors, lines, polylines and HUD overlays.",
    code: "drawPacman / drawShip / drawMessage",
  },
  {
    name: "Runtime helpers",
    text: "Run animation loops, sprite animators and finite state machines without adopting a full game framework.",
    code: "GridCanvasSystem.runtime.createAnimationLoop",
  },
  {
    name: "Input and motion",
    text: "Track keyboard and pointer state, convert angles, wrap bodies, test collisions and keep trails or particles alive.",
    code: "createKeyTracker / createPointerTracker",
  },
  {
    name: "Grid coordinates",
    text: "Convert canvas points to cells, cells to canvas points and snap interactions to a grid explicitly.",
    code: "canvasToGrid / gridToCanvas / snapPointToGrid",
  },
];

const docs = [
  {
    label: "Guides",
    text: "Install paths, first canvas, pixel sprites, runtime concepts and API orientation.",
    href: "/docs/",
  },
  {
    label: "Playground",
    text: "Edit and run pixel sprites, runtime loops, HUD scenes and pointer experiments with Monaco.",
    href: "/playground/",
  },
  {
    label: "Study",
    text: "Architecture, public API, rendering flow, packaging and verification notes.",
    href: `${repoUrl}/blob/main/docs/ESTUDIO_TECNICO.md`,
  },
  {
    label: "Findings",
    text: "Applied improvements, remaining risks and the current technical backlog.",
    href: `${repoUrl}/blob/main/docs/HALLAZGOS_Y_MEJORAS.md`,
  },
  {
    label: "Research",
    text: "Innovation strategy, market positioning, comparison with larger engines and scaling roadmap.",
    href: `${repoUrl}/blob/main/docs/INVESTIGACION_INNOVACION_ESCALADO.md`,
  },
  {
    label: "Changelog",
    text: "Release notes from 0.1.x through the current 0.3.0 runtime expansion.",
    href: `${repoUrl}/blob/main/CHANGELOG.md`,
  },
];

const examples = [
  {
    id: "buddy",
    name: "Grid Buddy",
    text: "A tiny companion built with pixel sprites, animator, state machine and local persistence.",
    number: "01",
    href: `${repoUrl}/tree/main/examples/vanilla/grid-buddy`,
  },
  {
    id: "runtime",
    name: "Runtime",
    text: "A moving actor driven by MassBody, keyboard input and requestAnimationFrame.",
    number: "02",
    href: `${repoUrl}/tree/main/examples/vanilla/runtime`,
  },
  {
    id: "hud",
    name: "HUD",
    text: "Value labels, status bars and centered messages for game-like overlays.",
    number: "03",
    href: `${repoUrl}/tree/main/examples/vanilla/hud`,
  },
  {
    id: "shapes",
    name: "Pixel Shapes",
    text: "Pac-Man, ghost, projectile, asteroid and spaceship primitives.",
    number: "04",
    href: `${repoUrl}/tree/main/examples/vanilla`,
  },
];

const codeBlocks = [
  {
    title: "Install",
    lang: "typescript",
    code: `npm install grid-canvas-system

import GridCanvasSystem from "grid-canvas-system";

const grid = new GridCanvasSystem("canvas", {
  width: 640,
  height: 360,
  cellSize: 20
});`,
  },
  {
    title: "Pixel Sprite",
    lang: "typescript",
    code: `grid.drawPixelSprite([
  "00111100",
  "01122110",
  "11222211"
], {
  x: 60,
  y: 45,
  pixelSize: 8,
  palette
});`,
  },
  {
    title: "Runtime",
    lang: "typescript",
    code: `const loop = GridCanvasSystem.runtime
  .createAnimationLoop({
    autoStart: true,
    update(elapsed) {
      animator.update(elapsed);
    },
    draw() {
      grid.clearCanvas();
    }
  });`,
  },
  {
    title: "Pointer Grid",
    lang: "typescript",
    code: `const pointer = GridCanvasSystem.runtime
  .createPointerTracker(grid.canvas);

const cell = GridCanvasSystem.runtime
  .canvasToGrid(pointer.position(), {
    cellSize: 20
  });`,
  },
];

const highlightedHeroCode = await codeToHtml(heroCode, {
  lang: "typescript",
  theme: "vitesse-black",
});
const highlightedCodeBlocks = await Promise.all(
  codeBlocks.map(async (block) => ({
    ...block,
    highlighted: await codeToHtml(block.code, {
      lang: block.lang,
      theme: "vitesse-black",
    }),
  })),
);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="grid-canvas-system is a tiny Canvas engine for grids, pixel art, sprites, animation, input, collisions and playful interactive systems."
    />
    <title>Grid Canvas System</title>
    <link rel="icon" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Geist+Pixel&display=swap"
    />
  </head>
  <body>
    <div class="site-shell">
      <header class="topbar" aria-label="Primary navigation">
        <a class="brand" href="#top" aria-label="Grid Canvas System home">
          <span class="brand-mark" aria-hidden="true"></span>
          <span>Grid Canvas System</span>
        </a>
        <nav class="nav-links" aria-label="Documentation navigation">
          <a href="#capabilities">Capabilities</a>
          <a href="/docs/">Docs</a>
          <a href="/playground/">Playground</a>
          <a href="#examples">Examples</a>
          <a class="nav-keep" href={npmUrl}>npm</a>
        </nav>
      </header>

      <main id="top">
        <section class="hero" aria-label="Grid Canvas System landing hero">
          <canvas id="hero-canvas"></canvas>
          <div>
            <div class="hero-content">
              <div>
                <p class="eyebrow">v{version} / Tiny Canvas Engine</p>
                <h1>
                  <span>Grid</span>
                  <span>Canvas</span>
                  <span>System</span>
                </h1>
                <p class="hero-copy">
                  Build small interactive Canvas scenes with grids, pixel art, sprites,
                  animation, input, collisions and lightweight runtime helpers.
                </p>
                <p class="hero-subcopy">
                  Designed for teaching, playful tools, arcade sketches and readable
                  demos that stay closer to the Canvas API than a full engine.
                </p>
                <div class="hero-actions" aria-label="Primary links">
                  <a class="button primary" href={npmUrl}>npm install</a>
                  <a class="button" href="/docs/">Read docs</a>
                  <a class="button" href="/playground/">Open playground</a>
                  <a class="button" href={`${repoUrl}/tree/main/examples/vanilla`}>
                    View examples
                  </a>
                </div>
              </div>

              <aside class="hero-panel" aria-label="Runtime code preview">
                <header>
                  <span>runtime.sketch.ts</span>
                  <div class="panel-actions">
                    <span class="panel-light" aria-hidden="true"></span>
                    <button
                      class="copy-button"
                      type="button"
                      data-copy-target="hero-code"
                      data-tooltip="Copy code"
                      aria-label="Copy runtime code"
                    >
                      <Copy class="copy-icon" size={14} aria-hidden="true" />
                      <Check class="check-icon" size={14} aria-hidden="true" />
                    </button>
                  </div>
                </header>
                <div
                  id="hero-code"
                  class="highlighted-code hero-highlight"
                  set:html={highlightedHeroCode}
                />
                <footer>
                  <span>ESM + UMD</span>
                  <span>0 dependencies runtime</span>
                </footer>
              </aside>
            </div>

            <div class="peek-strip" aria-label="Documentation highlights">
              <span>Grid helpers</span>
              <span>Pixel sprites</span>
              <span>State machines</span>
              <span>Visual snapshots</span>
            </div>
          </div>
        </section>

        <section class="section" id="capabilities">
          <div class="section-header">
            <div>
              <p class="section-kicker">Capability Matrix</p>
              <h2>Small surface, enough runtime to feel alive.</h2>
            </div>
            <p class="section-lede">
              The package keeps the core direct and adds reusable primitives only when
              they unlock many demos: drawing, motion, state, input, particles and
              grid-aware interaction.
            </p>
          </div>

          <div class="capability-grid">
            {
              capabilities.map((capability, index) => (
                <article class="capability">
                  <span class="capability-index">
                    {(index + 1).toString().padStart(2, "0")}
                  </span>
                  <h3>{capability.name}</h3>
                  <p>{capability.text}</p>
                  <code>{capability.code}</code>
                </article>
              ))
            }
          </div>
        </section>

        <section class="section docs-band" id="docs">
          <div>
            <p class="section-kicker">Documentation Map</p>
            <h2>Everything useful stays one click from the package.</h2>
          </div>
          <div class="doc-list">
            {
              docs.map((doc) => (
                <a class="doc-link" href={doc.href}>
                  <strong>{doc.label}</strong>
                  <span>{doc.text}</span>
                </a>
              ))
            }
          </div>
        </section>

        <section class="section">
          <div class="section-header">
            <div>
              <p class="section-kicker">API Lanes</p>
              <h2>Copyable paths from blank canvas to moving scene.</h2>
            </div>
            <p class="section-lede">
              Each lane maps to a documented public API. The landing page uses the same
              local source through Astro, so the showcase evolves with the library.
            </p>
          </div>

          <div class="code-wall">
            {
              highlightedCodeBlocks.map((block, index) => (
                <article class="code-block">
                  <header class="code-block-header">
                    <h3>{block.title}</h3>
                    <button
                      class="copy-button"
                      type="button"
                      data-copy-target={`code-block-${index}`}
                      data-tooltip="Copy code"
                      aria-label={`Copy ${block.title} code`}
                    >
                      <Copy class="copy-icon" size={14} aria-hidden="true" />
                      <Check class="check-icon" size={14} aria-hidden="true" />
                    </button>
                  </header>
                  <div
                    id={`code-block-${index}`}
                    class="highlighted-code"
                    set:html={block.highlighted}
                  />
                </article>
              ))
            }
          </div>
        </section>

        <section class="section tight" id="examples">
          <div class="section-header">
            <div>
              <p class="section-kicker">Example Gallery</p>
              <h2>Readable demos before framework ceremony.</h2>
            </div>
            <p class="section-lede">
              Vanilla examples remain the reference path: CDN-friendly, framework-free
              and close enough to the source for students to follow.
            </p>
          </div>

          <div class="examples">
            {
              examples.map((example) => (
                <article class="example" data-number={example.number}>
                  <div class="example-stage">
                    <canvas
                      id={`demo-${example.id}`}
                      class="example-canvas"
                      tabindex={example.id === "runtime" ? "0" : undefined}
                      aria-label={`${example.name} live demo`}
                    />
                    <span class="example-live">
                      <i /> Live
                    </span>
                  </div>
                  <div class="example-body">
                    <div class="example-title-row">
                      <h3>{example.name}</h3>
                      <a
                        class="example-source"
                        href={example.href}
                        aria-label={`Open ${example.name} source`}
                        data-tooltip="View source"
                      >
                        <ArrowUpRight size={16} aria-hidden="true" />
                      </a>
                    </div>
                    <p>{example.text}</p>
                    {example.id === "buddy" && (
                      <div class="buddy-controls" aria-label="Grid Buddy controls">
                        <button type="button" data-buddy-action="feed">
                          <Cookie size={14} aria-hidden="true" /> Feed
                        </button>
                        <button type="button" data-buddy-action="play">
                          <Gamepad2 size={14} aria-hidden="true" /> Play
                        </button>
                        <button type="button" data-buddy-action="nap">
                          <Moon size={14} aria-hidden="true" /> Nap
                        </button>
                      </div>
                    )}
                    {example.id === "runtime" && (
                      <span class="example-hint">Focus canvas + arrow keys</span>
                    )}
                  </div>
                </article>
              ))
            }
          </div>
        </section>

        <section class="section install" id="install">
          <div>
            <p class="section-kicker">Release {version}</p>
            <h2>Published package, CI, visual tests and docs in sync.</h2>
          </div>
          <div class="install-panel">
            <pre><code>{`pnpm add grid-canvas-system

pnpm test
pnpm run test:visual
pnpm run build`}</code></pre>
          </div>
          <div class="release-list" aria-label="Release highlights">
            <div>
              <strong>0.3.0</strong>
              <span>Grid coordinate helpers and pointer tracking.</span>
            </div>
            <div>
              <strong>0.2.0</strong>
              <span>Pixel sprites, animator, state machine and Grid Buddy.</span>
            </div>
            <div>
              <strong>0.1.x</strong>
              <span>Core canvas/grid API, drawing helpers and visual snapshots.</span>
            </div>
          </div>
        </section>
      </main>

      <footer class="footer">
        <span>MIT / Josue Oroya</span>
        <span>A tiny canvas engine for playful interactive systems.</span>
      </footer>
    </div>

    <script>
      import "../scripts/showcase";
      import "../scripts/live-examples";
      import "../scripts/copy";
      import "../scripts/motion";
    </script>
  </body>
</html>
