---
import {
  ArrowUpRight,
  Check,
  Cookie,
  Copy,
  Gamepad2,
  Menu,
  Moon,
  X,
} from "@lucide/astro";
import { codeToHtml } from "shiki";

import { type HomeLocale, homeContentByLocale } from "../../data/homeContent";
import { libraryVersion } from "../../data/siteRelease";
import "../../styles/global.css";

interface Props {
  locale: HomeLocale;
}

const { locale } = Astro.props;
const content = homeContentByLocale[locale];
const currentHomeHref = locale === "en" ? "/" : `/${locale}/`;
const version = libraryVersion;
const repoUrl = "https://github.com/joshuacba08/grid-canvas-system";
const npmUrl = "https://www.npmjs.com/package/grid-canvas-system";
const heroCode = `const grid = new GridCanvasSystem("canvas", {
  cellSize: 20,
  backgroundColor: "#050607"
});

const player = GridCanvasSystem.compilePixelSprite([
  "0110",
  "1111",
  "1001"
], {
  "0": "transparent",
  "1": "#00D43B"
});

const loop = GridCanvasSystem.runtime
  .createFixedStepLoop({
    autoStart: true,
    step: 1 / 60,
    update: tick,
    draw: render
  });`;

const codeBlocks = [
  {
    title: content.codeBlockTitles.install,
    lang: "typescript",
    code: `npm install grid-canvas-system

import GridCanvasSystem from "grid-canvas-system";

const grid = new GridCanvasSystem("canvas", {
  width: 640,
  height: 360,
  cellSize: 20
});`,
  },
  {
    title: content.codeBlockTitles.pixelSprite,
    lang: "typescript",
    code: `const palette = GridCanvasSystem.createPixelPalette({
  "0": "transparent",
  "1": "#00D43B",
  "2": "#4DA9FF"
});

const compiled = GridCanvasSystem.compilePixelSprite([
  "00111100",
  "01122110",
  "11222211"
], palette);

grid.drawCompiledPixelSprite(compiled, {
  x: 60,
  y: 45,
  pixelSize: 8
});`,
  },
  {
    title: content.codeBlockTitles.runtime,
    lang: "typescript",
    code: `const loop = GridCanvasSystem.runtime
  .createFixedStepLoop({
    autoStart: true,
    step: 1 / 60,
    update(step) {
      scene.update(step);
    },
    draw() {
      grid.clearCanvas();
      scene.draw(grid);
    }
  });`,
  },
  {
    title: content.codeBlockTitles.audioArcade,
    lang: "typescript",
    code: `import { createArcadeAudio } from "grid-canvas-system/audio-arcade";

const audio = createArcadeAudio({
  masterVolume: 0.72
});

button.addEventListener("click", async () => {
  await audio.playShoot();
  await audio.playLoop("patrol");
});`,
  },
  {
    title: content.codeBlockTitles.pointerGrid,
    lang: "typescript",
    code: `GridCanvasSystem.runtime.drawTileMap(
  ["111111", "100001", "101101", "111111"],
  {
    "1": { color: "#00D43B" },
    "0": { color: "transparent" }
  },
  { grid, tileSize: 20 }
);

const hit = GridCanvasSystem.runtime.hitTestTileMap(
  { x: 20, y: 20, width: 16, height: 16 },
  ["111111", "100001", "101101", "111111"],
  new Set(["1"]),
  { tileSize: 20 }
);`,
  },
];

const highlightedHeroCode = await codeToHtml(heroCode, {
  lang: "typescript",
  theme: "vitesse-black",
});
const highlightedCodeBlocks = await Promise.all(
  codeBlocks.map(async (block) => ({
    ...block,
    highlighted: await codeToHtml(block.code, {
      lang: block.lang,
      theme: "vitesse-black",
    }),
  })),
);
const footerLinks = [
  { href: content.docsPath, label: content.nav.docs },
  { href: "/playground/", label: content.nav.playground },
  { href: `${repoUrl}/tree/main/examples/vanilla`, label: content.nav.examples },
  { href: npmUrl, label: "npm" },
  { href: repoUrl, label: "GitHub" },
  {
    href:
      content.docs[content.docs.length - 1]?.href ??
      `${repoUrl}/blob/main/CHANGELOG.md`,
    label: content.docs[content.docs.length - 1]?.label ?? "Changelog",
  },
];
const latestRelease = content.release.timeline[0];
---

<!doctype html>
<html lang={content.htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={content.metaDescription} />
    <title>{content.pageTitle}</title>
    <link rel="icon" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Geist+Pixel&family=Noto+Sans+JP:wght@400;500;700&display=swap"
    />
    <style is:inline>
      html {
        background: #050607;
      }

      body.grid-loader-active {
        overflow: hidden;
        background: #050607;
      }

      body.grid-loader-active .site-shell {
        visibility: hidden;
        opacity: 0;
        pointer-events: none;
      }

      .site-shell {
        transition: opacity 180ms ease;
      }

      .grid-loader {
        position: fixed;
        z-index: 9999;
        inset: 0;
        overflow: hidden;
        background:
          radial-gradient(circle at 50% 38%, rgba(0, 212, 59, 0.12), transparent 34rem),
          linear-gradient(180deg, rgba(77, 169, 255, 0.08), transparent 30rem), #050607;
        color: #e8f7ef;
        font-family:
          "Geist Pixel", "Cascadia Mono", "SFMono-Regular", Consolas, monospace;
        transition:
          opacity 360ms ease,
          visibility 360ms ease;
      }

      .grid-loader[data-state="leaving"] {
        visibility: hidden;
        opacity: 0;
        pointer-events: none;
      }

      .grid-loader-frame {
        position: relative;
        width: 100%;
        min-height: 100svh;
      }

      .grid-loader-header {
        position: absolute;
        z-index: 2;
        top: clamp(24px, 8svh, 72px);
        left: 50%;
        display: grid;
        grid-template-columns: auto minmax(0, 1fr) auto;
        width: min(640px, calc(100vw - 40px));
        align-items: center;
        gap: 12px;
        transform: translateX(-50%);
      }

      .grid-loader-title {
        min-width: 0;
        overflow: hidden;
        color: #e8f7ef;
        font-size: clamp(13px, 2.3vw, 16px);
        text-overflow: ellipsis;
        text-transform: uppercase;
        white-space: nowrap;
      }

      .grid-loader-mark {
        display: grid;
        width: 30px;
        height: 30px;
        border: 1px solid rgba(0, 212, 59, 0.7);
        background:
          linear-gradient(90deg, transparent 43%, #00d43b 43% 57%, transparent 57%),
          linear-gradient(transparent 43%, #00d43b 43% 57%, transparent 57%), #07110a;
        box-shadow: 0 0 24px rgba(0, 212, 59, 0.36);
      }

      .grid-loader-percent {
        color: #00d43b;
        font-size: clamp(14px, 2vw, 18px);
        text-align: right;
      }

      .grid-loader-canvas {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        border: 0;
        background: #050607;
        image-rendering: pixelated;
      }

      @media (max-width: 620px) {
        .grid-loader-header {
          grid-template-columns: auto minmax(0, 1fr);
        }

        .grid-loader-percent {
          grid-column: 1 / -1;
          text-align: left;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .site-shell,
        .grid-loader {
          transition: none;
        }
      }
    </style>
    <noscript>
      <style>
        body.grid-loader-active .site-shell {
          visibility: visible;
          opacity: 1;
          pointer-events: auto;
        }

        .grid-loader {
          display: none;
        }
      </style>
    </noscript>
    <script is:inline>
      window.setTimeout(() => {
        if (document.documentElement.dataset.pageLoader === "complete") {
          return;
        }

        document.documentElement.dataset.pageLoader = "complete";
        document.body?.classList.remove("grid-loader-active");
        document.querySelector("[data-page-loader]")?.remove();
        window.requestAnimationFrame(() => {
          document.dispatchEvent(new CustomEvent("grid-loader:complete"));
        });
      }, 8000);
    </script>
  </head>
  <body class="grid-loader-active">
    <div class="grid-loader" data-page-loader role="status" aria-live="polite">
      <div class="grid-loader-frame">
        <div class="grid-loader-header">
          <span class="grid-loader-mark" aria-hidden="true"></span>
          <span class="grid-loader-title">{content.loader.label}</span>
          <strong class="grid-loader-percent" data-page-loader-percent>0%</strong>
        </div>
        <canvas
          id="page-loader-canvas"
          class="grid-loader-canvas"
          data-page-loader-canvas
          aria-label={content.loader.canvasLabel}></canvas>
      </div>
    </div>
    <div class="site-shell">
      <header class="topbar" aria-label={content.primaryNavAria}>
        <a class="brand" href="#top" aria-label={content.brandAria}>
          <span class="brand-mark" aria-hidden="true"></span>
          <span>Grid Canvas System</span>
        </a>
        <nav
          id="home-nav-panel"
          class="nav-links"
          aria-label={content.primaryNavAria}
          data-home-nav
          data-open="false"
        >
          <a href="#capabilities" data-home-nav-link>{content.nav.capabilities}</a>
          <a href={content.docsPath} data-home-nav-link>{content.nav.docs}</a>
          <a href="/playground/" data-home-nav-link>{content.nav.playground}</a>
          <a href="#examples" data-home-nav-link>{content.nav.examples}</a>
          <a class="nav-keep" href={npmUrl} data-home-nav-link>npm</a>
        </nav>
        <div class="topbar-tools">
          <span class="nav-version" aria-label={`${content.versionLabel} ${version}`}>
            v{version}
          </span>
          <label class="nav-locale-select" aria-label={content.localeNavAria}>
            <span class="sr-only">{content.localeSelectLabel}</span>
            <select data-home-locale-select aria-label={content.localeSelectLabel}>
              {
                content.localeLinks.map((link) => (
                  <option value={link.href} selected={link.href === currentHomeHref}>
                    {link.label}
                  </option>
                ))
              }
            </select>
          </label>
          <button
            class="home-menu-button"
            type="button"
            aria-label={content.menuButtonLabel}
            aria-expanded="false"
            aria-controls="home-nav-panel"
            data-home-menu
          >
            <Menu class="menu-open-icon" size={18} aria-hidden="true" />
            <X class="menu-close-icon" size={18} aria-hidden="true" />
          </button>
        </div>
      </header>

      <main id="top">
        <section class="hero" aria-label={content.brandAria}>
          <canvas id="hero-canvas"></canvas>
          <div>
            <div class="hero-content">
              <div>
                <p class="eyebrow">{content.hero.eyebrow}</p>
                <h1>
                  <span>Grid</span>
                  <span>Canvas</span>
                  <span>System</span>
                </h1>
                <p class="hero-copy">{content.hero.copy}</p>
                <p class="hero-subcopy">{content.hero.subcopy}</p>
                <div class="hero-actions" aria-label={content.primaryNavAria}>
                  <a class="button primary" href={npmUrl}
                    >{content.hero.actions.install}</a
                  >
                  <a class="button" href={content.docsPath}
                    >{content.hero.actions.docs}</a
                  >
                  <a class="button" href="/playground/"
                    >{content.hero.actions.playground}</a
                  >
                  <a class="button" href={`${repoUrl}/tree/main/examples/vanilla`}>
                    {content.hero.actions.examples}
                  </a>
                </div>
              </div>

              <aside class="hero-panel" aria-label={content.hero.panelLabel}>
                <header>
                  <span>runtime.sketch.ts</span>
                  <div class="panel-actions">
                    <span class="panel-light" aria-hidden="true"></span>
                    <button
                      class="copy-button"
                      type="button"
                      data-copy-target="hero-code"
                      data-tooltip="Copy code"
                      aria-label="Copy runtime code"
                    >
                      <Copy class="copy-icon" size={14} aria-hidden="true" />
                      <Check class="check-icon" size={14} aria-hidden="true" />
                    </button>
                  </div>
                </header>
                <div
                  id="hero-code"
                  class="highlighted-code hero-highlight"
                  set:html={highlightedHeroCode}
                />
                <footer>
                  <span>{content.hero.panelFooter[0]}</span>
                  <span>{content.hero.panelFooter[1]}</span>
                </footer>
              </aside>
            </div>

            <div class="peek-strip" aria-label="Documentation highlights">
              {content.peekStrip.map((item) => <span>{item}</span>)}
            </div>
          </div>
        </section>

        <section class="section" id="capabilities">
          <div class="section-header">
            <div>
              <p class="section-kicker">{content.capabilitiesSection.kicker}</p>
              <h2>{content.capabilitiesSection.title}</h2>
            </div>
            <p class="section-lede">{content.capabilitiesSection.lede}</p>
          </div>

          <div class="capability-grid">
            {
              content.capabilities.map((capability, index) => (
                <article class="capability">
                  <span class="capability-index">
                    {(index + 1).toString().padStart(2, "0")}
                  </span>
                  <h3>{capability.name}</h3>
                  <p>{capability.text}</p>
                  <code>{capability.code}</code>
                </article>
              ))
            }
          </div>
        </section>

        <section class="section docs-band" id="docs">
          <div>
            <p class="section-kicker">{content.docsSection.kicker}</p>
            <h2>{content.docsSection.title}</h2>
          </div>
          <div class="doc-list">
            {
              content.docs.map((doc) => (
                <a class="doc-link" href={doc.href}>
                  <strong>{doc.label}</strong>
                  <span>{doc.text}</span>
                </a>
              ))
            }
          </div>
        </section>

        <section class="section">
          <div class="section-header">
            <div>
              <p class="section-kicker">{content.api.kicker}</p>
              <h2>{content.api.title}</h2>
            </div>
            <p class="section-lede">{content.api.lede}</p>
          </div>

          <div class="code-wall">
            {
              highlightedCodeBlocks.map((block, index) => (
                <article class="code-block">
                  <header class="code-block-header">
                    <h3>{block.title}</h3>
                    <button
                      class="copy-button"
                      type="button"
                      data-copy-target={`code-block-${index}`}
                      data-tooltip="Copy code"
                      aria-label={`Copy ${block.title} code`}
                    >
                      <Copy class="copy-icon" size={14} aria-hidden="true" />
                      <Check class="check-icon" size={14} aria-hidden="true" />
                    </button>
                  </header>
                  <div
                    id={`code-block-${index}`}
                    class="highlighted-code"
                    set:html={block.highlighted}
                  />
                </article>
              ))
            }
          </div>
        </section>

        <section class="section tight" id="examples">
          <div class="section-header">
            <div>
              <p class="section-kicker">{content.examplesSection.kicker}</p>
              <h2>{content.examplesSection.title}</h2>
            </div>
            <p class="section-lede">{content.examplesSection.lede}</p>
          </div>

          <div class="examples">
            {
              content.examples.map((example) => (
                <article class="example" data-number={example.number}>
                  <div class="example-stage">
                    <canvas
                      id={`demo-${example.id}`}
                      class="example-canvas"
                      tabindex={example.id === "runtime" ? "0" : undefined}
                      aria-label={`${example.name} ${content.liveDemoSuffix}`}
                    />
                    <span class="example-live">
                      <i /> {content.liveBadge}
                    </span>
                  </div>
                  <div class="example-body">
                    <div class="example-title-row">
                      <h3>{example.name}</h3>
                      <a
                        class="example-source"
                        href={example.href}
                        aria-label={`${content.sourceAriaPrefix} ${example.name}`}
                        data-tooltip={content.sourceTooltip}
                      >
                        <ArrowUpRight size={16} aria-hidden="true" />
                      </a>
                    </div>
                    <p>{example.text}</p>
                    {example.id === "buddy" && (
                      <div class="buddy-controls" aria-label="Grid Buddy controls">
                        <button type="button" data-buddy-action="feed">
                          <Cookie size={14} aria-hidden="true" />{" "}
                          {content.buddyControls.feed}
                        </button>
                        <button type="button" data-buddy-action="play">
                          <Gamepad2 size={14} aria-hidden="true" />{" "}
                          {content.buddyControls.play}
                        </button>
                        <button type="button" data-buddy-action="nap">
                          <Moon size={14} aria-hidden="true" />{" "}
                          {content.buddyControls.nap}
                        </button>
                      </div>
                    )}
                    {example.id === "audio-arcade" && (
                      <>
                        <div
                          class="example-controls"
                          aria-label="Audio Arcade controls"
                        >
                          <button type="button" data-home-audio-action="shoot">
                            {content.audioControls.shoot}
                          </button>
                          <button type="button" data-home-audio-action="pickup">
                            {content.audioControls.pickup}
                          </button>
                          <button type="button" data-home-audio-action="loop">
                            {content.audioControls.loop}
                          </button>
                          <button type="button" data-home-audio-action="stop">
                            {content.audioControls.stop}
                          </button>
                          <button type="button" data-home-audio-action="mute">
                            {content.audioControls.mute}
                          </button>
                        </div>
                        <span class="example-hint" data-home-audio-status>
                          {content.audioControls.initialStatus}
                        </span>
                      </>
                    )}
                    {example.id === "runtime" && (
                      <span class="example-hint">{content.runtimeHint}</span>
                    )}
                  </div>
                </article>
              ))
            }
          </div>
        </section>

        <section class="section install" id="install">
          <div>
            <p class="section-kicker">{content.release.kicker} {version}</p>
            <h2>{content.release.title}</h2>
          </div>
          <div
            class="install-panel terminal-panel"
            data-home-terminal
            data-terminal-done-label={content.terminal.states.done}
            data-terminal-pending-label={content.terminal.states.pending}
            data-terminal-phase-done={content.terminal.phaseDone}
            data-terminal-phase-idle={content.terminal.phaseIdle}
            data-terminal-working-label={content.terminal.states.working}
          >
            <header class="terminal-header">
              <div class="terminal-lights" aria-hidden="true">
                <i></i>
                <i></i>
                <i></i>
              </div>
              <div class="terminal-title">
                <strong>{content.terminal.headerTitle}</strong>
                <span>{content.terminal.headerSubtitle}</span>
              </div>
              <span class="terminal-phase" data-terminal-phase>
                {content.terminal.phaseIdle}
              </span>
            </header>
            <div class="terminal-body">
              {
                content.terminal.steps.map((step) => (
                  <article class="terminal-row" data-terminal-row data-state="pending">
                    <div class="terminal-row-main">
                      <span class="terminal-prompt" aria-hidden="true">
                        $
                      </span>
                      <code>{step.command}</code>
                      <span class="terminal-status" data-terminal-status>
                        {content.terminal.states.pending}
                      </span>
                    </div>
                    <small>{step.note}</small>
                  </article>
                ))
              }
            </div>
          </div>
          <div class="release-list" aria-label="Release highlights">
            {
              content.release.timeline.map((release) => (
                <div>
                  <strong>{release.version}</strong>
                  <span>{release.summary}</span>
                </div>
              ))
            }
          </div>
        </section>
      </main>

      <footer class="footer">
        <div class="footer-shell">
          <section class="footer-lead">
            <div class="footer-brand-lockup">
              <span class="brand-mark" aria-hidden="true"></span>
              <div>
                <strong>Grid Canvas System</strong>
                <span>{content.hero.eyebrow}</span>
              </div>
            </div>
            <p class="footer-copy">{content.footer.right}</p>
            <div class="footer-actions" aria-label={content.primaryNavAria}>
              <a class="button primary" href={npmUrl}>{content.hero.actions.install}</a>
              <a class="button" href={content.docsPath}>{content.hero.actions.docs}</a>
              <a class="button" href="/playground/">{content.hero.actions.playground}</a
              >
            </div>
          </section>

          <section class="footer-card" aria-label={content.docsSection.kicker}>
            <p class="footer-kicker">{content.docsSection.kicker}</p>
            <div class="footer-link-grid">
              {
                footerLinks.map((link) => (
                  <a class="footer-link" href={link.href}>
                    <span>{link.label}</span>
                    <ArrowUpRight size={14} aria-hidden="true" />
                  </a>
                ))
              }
            </div>
          </section>

          <section
            class="footer-card footer-release-card"
            aria-label={content.release.kicker}
          >
            <p class="footer-kicker">
              {content.release.kicker}
              {version}
            </p>
            <div class="footer-version-row">
              <strong>v{version}</strong>
              <span>{content.versionLabel}</span>
            </div>
            <p class="footer-release-copy">{latestRelease.summary}</p>
            <div class="footer-chip-row">
              <span class="footer-chip">{content.hero.panelFooter[0]}</span>
              <span class="footer-chip">{content.hero.panelFooter[1]}</span>
              <span class="footer-chip">MIT</span>
            </div>
          </section>
        </div>

        <div class="footer-bottom">
          <span class="footer-credit">MIT / Josue Oroya</span>
          <nav class="footer-locale-links" aria-label={content.localeNavAria}>
            {
              content.localeLinks.map((link) => (
                <a
                  class="footer-locale-link"
                  href={link.href}
                  aria-current={link.href === currentHomeHref ? "page" : undefined}
                >
                  {link.label}
                </a>
              ))
            }
          </nav>
        </div>
      </footer>
    </div>

    <script>
      import "../../scripts/page-loader";
      import "../../scripts/copy";
      import "../../scripts/home";
      import "../../scripts/live-examples";
      import "../../scripts/showcase";
    </script>
    <script>
      import "../../scripts/motion";
    </script>
  </body>
</html>
