---
import { libraryVersion } from "../data/siteRelease";
interface Props {
  locale?: "en" | "es" | "ja";
}
const { locale = "en" } = Astro.props;
const copy = {
  en: [
    "Version",
    "Install this version with npm install grid-canvas-system.",
    "Device checks",
  ],
  es: [
    "Versión",
    "Instala esta versión con npm install grid-canvas-system.",
    "Pruebas en dispositivo",
  ],
  ja: [
    "バージョン",
    "npm install grid-canvas-system でこのバージョンを導入できます。",
    "実機テスト",
  ],
}[locale];
---

<aside class="candidate-notice" data-release-version>
  <strong>{copy[0]} {libraryVersion}</strong>
  <span>{copy[1]}</span>
  <a href="/qa/">{copy[2]}</a>
</aside>
<style>
  .candidate-notice {
    position: relative;
    z-index: 1;
    display: flex;
    flex-shrink: 0;
    flex-wrap: wrap;
    gap: 8px 16px;
    padding: 12px 24px;
    border-bottom: 1px solid #365b58;
    background: #102c2a;
    color: #f1f5f9;
    font:
      14px/1.5 system-ui,
      sans-serif;
  }
  a {
    color: #5eead4;
    text-decoration: underline;
  }
</style>
