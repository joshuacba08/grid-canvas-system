{
  "name": "grid-canvas-system",
  "version": "1.1.0",
  "packageManager": "pnpm@11.7.0",
  "type": "module",
  "private": false,
  "sideEffects": false,
  "description": "Build small interactive Canvas scenes with grids, pixel art, sprites, animation, input, collisions and lightweight runtime helpers.",
  "main": "dist/grid-canvas-system.umd.js",
  "module": "dist/grid-canvas-system.es.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/grid-canvas-system.es.js",
      "default": "./dist/grid-canvas-system.es.js"
    },
    "./audio": {
      "types": "./dist/audio/index.d.ts",
      "import": "./dist/audio/index.js",
      "default": "./dist/audio/index.js"
    },
    "./audio-arcade": {
      "types": "./dist/audio-arcade/index.d.ts",
      "import": "./dist/audio-arcade/index.js",
      "default": "./dist/audio-arcade/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js",
      "default": "./dist/runtime/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --config vite.audio.config.ts && tsc -p tsconfig.build.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview",
    "benchmark:pixel-sprites": "node scripts/benchmark-pixel-sprites.mjs",
    "test": "vitest run",
    "test:visual": "vitest run tests/GridCanvasSystem.visual.test.ts",
    "test:visual:update": "npm run build && node scripts/update-visual-snapshots.mjs",
    "verify:types": "tsc -p tsconfig.types-smoke.json",
    "verify:package-exports": "node scripts/verify-package-exports.mjs",
    "test:watch": "vitest",
    "site:dev": "pnpm --filter grid-canvas-system-site dev",
    "site:build": "pnpm --filter grid-canvas-system-site build",
    "site:preview": "pnpm --filter grid-canvas-system-site preview"
  },
  "files": [
    "CHANGELOG.md",
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "docs"
  ],
  "keywords": [
    "canvas",
    "grid",
    "pixel-art",
    "sprites",
    "animation",
    "game-dev",
    "typescript",
    "html5-canvas"
  ],
  "author": "Josue Oroya",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joshuacba08/grid-canvas-system.git"
  },
  "homepage": "https://github.com/joshuacba08/grid-canvas-system#readme",
  "bugs": {
    "url": "https://github.com/joshuacba08/grid-canvas-system/issues"
  },
  "peerDependencies": {
    "howler": "^2.2.4",
    "tone": "^15.1.22"
  },
  "peerDependenciesMeta": {
    "howler": {
      "optional": true
    },
    "tone": {
      "optional": true
    }
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.4",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "~5.6.2",
    "vite": "^6.0.1",
    "vitest": "^4.1.9"
  }
}
